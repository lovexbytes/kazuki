  {
   "type": "text",
   "id": "disk_t",
   "x": 56,
   "y": 942,
   "width": 730,
   "height": 210,
   "text": "~/.kazuki/\n\u251c\u2500 config.json  auth.json (method + urls, NO keys)\n\u251c\u2500 server.log   cloud.db (act dedup only)\n\u251c\u2500 work/main/   work/<Agent>/       \u2190 tools run here\n\u2514\u2500 users/local/\n   \u251c\u2500 main/ + main.index   messages, 1 JSON line each\n   \u251c\u2500 tree/ + tree.index   summary nodes (the tree)\n   \u251c\u2500 view.json            current view, pick, goal\n   \u2514\u2500 docs/images/  docs/agent/<Name>.jsonl",
   "originalText": "~/.kazuki/\n\u251c\u2500 config.json  auth.json (method + urls, NO keys)\n\u251c\u2500 server.log   cloud.db (act dedup only)\n\u251c\u2500 work/main/   work/<Agent>/       \u2190 tools run here\n\u2514\u2500 users/local/\n   \u251c\u2500 main/ + main.index   messages, 1 JSON line each\n   \u251c\u2500 tree/ + tree.index   summary nodes (the tree)\n   \u251c\u2500 view.json            current view, pick, goal\n   \u2514\u2500 docs/images/  docs/agent/<Name>.jsonl",
   "fontSize": 15,
