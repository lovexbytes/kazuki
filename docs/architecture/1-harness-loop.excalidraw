    {"type":"text","id":"req_t","x":716,"y":342,"width":530,"height":228,"text":"POST /v1/messages\n{\n  \"model\": \"claude-opus-5-5\",\n  \"system\": \"You are ...\",\n  \"tools\": [{\"name\":\"shell\",\"input_schema\":{..}}],\n  \"messages\": [\n    {\"role\":\"user\", \"content\":\"fix the test\"},\n    {\"role\":\"assistant\", \"content\":[tool_use]},\n    {\"role\":\"user\", \"content\":[tool_result]}\n  ],\n  \"stream\": true\n}","originalText":"POST /v1/messages\n{\n  \"model\": \"claude-opus-5-5\",\n  \"system\": \"You are ...\",\n  \"tools\": [{\"name\":\"shell\",\"input_schema\":{..}}],\n  \"messages\": [\n    {\"role\":\"user\", \"content\":\"fix the test\"},\n    {\"role\":\"assistant\", \"content\":[tool_use]},\n    {\"role\":\"user\", \"content\":[tool_result]}\n  ],\n  \"stream\": true\n}","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1029,"version":1,"versionNonce":1029,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
