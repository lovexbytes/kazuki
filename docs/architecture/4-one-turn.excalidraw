  {
   "type": "rectangle",
   "id": "list_box",
   "x": 40,
   "y": 670,
   "width": 1660,
   "height": 335,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 4400,
   "version": 1,
   "versionNonce": 4400,
   "isDeleted": false,
