  {
   "type": "text",
   "id": "br_turns_t",
   "x": 40,
   "y": 1260,
   "width": 660,
   "height": 54,
   "text": "same bytes from turn to turn (until a merge batch)\n= cache hit ACROSS turns. All past turns, their\ntool calls and outputs live here as \u2264512 B lines.",
